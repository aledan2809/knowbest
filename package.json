{
  "name": "knowbest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run sync-ai-router && next dev",
    "build": "npm run sync-ai-router && NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint",
    "sync-ai-router": "rm -rf node_modules/ai-router && mkdir -p node_modules/ai-router && cp ../AIRouter/package.json node_modules/ai-router/ && cp -r ../AIRouter/dist node_modules/ai-router/dist",
    "postinstall": "npm run sync-ai-router && node scripts/patch-next-build.js"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@base-ui/react": "^1.3.0",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.36.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.4",
    "next-auth": "^4.24.13",
    "next-intl": "^4.9.0",
    "nodemailer": "^7.0.13",
    "prisma": "^6.19.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "resend": "^6.10.0",
    "shadcn": "^4.0.8",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
